# Argo CD credentials for this private repository. Rendered by the e2e job
# with envsubst; GITHUB_TOKEN is the job's short-lived token.
apiVersion: v1
kind: Secret
metadata:
  name: repo-devsecops-demo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: https://github.com/${GITHUB_REPOSITORY}.git
  username: x-access-token
  password: ${GITHUB_TOKEN}
